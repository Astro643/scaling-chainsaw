# Supabase Edge Functions Configuration

# Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (for admin operations)
# This is automatically available in Edge Functions as SUPABASE_SERVICE_ROLE_KEY
# But you need it for local development
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API Key (for embedding generation)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Supabase Project Reference (for CLI deployment)
SUPABASE_PROJECT_REF=your-project-ref

# Supabase Database URL (for local migration testing)
SUPABASE_DB_URL=postgresql://postgres:your-password@localhost:5432/postgres

# Optional: Custom Gemini model
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
